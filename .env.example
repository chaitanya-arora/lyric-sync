# Copy to .env (in this folder) and fill in. Never commit .env itself.

# From your app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a redirect URI saved on that app, exactly
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/callback

# https://www.deepl.com/your-account/keys (the free plan works)
DEEPL_API_KEY=

# Any long random string; keep it the same between restarts or everyone is signed out
FLASK_SECRET_KEY=

# Optional. Without it, LyricSync keeps its data in backend/translations.db (SQLite).
# DATABASE_URL=postgresql://user:password@localhost:5432/lyricsync
